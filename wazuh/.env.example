# Copy to .env and fill in. .env is git-ignored.
WAZUH_VERSION=4.14.9
# Indexer JVM heap. Keep 2g on the 6 GB wazuh01 VM.
INDEXER_HEAP=2g
# Passwords need 8-64 chars with upper, lower, digit and symbol.
# admin (dashboard login)
INDEXER_PASSWORD=
# kibanaserver (dashboard to indexer)
DASHBOARD_PASSWORD=
# wazuh-wui (Wazuh API)
API_PASSWORD=
# Agent enrollment password; web01/ and the Windows script use the same value.
ENROLL_PASSWORD=
